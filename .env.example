# Kadr — example environment (copy to .env for local Docker Compose; never commit secrets).

KADR_HTTP_PORT=8088
KADR_VERSION=stage0
KADR_COMMIT=local
KADR_BUILD_TIME=local
KADR_LOG_LEVEL=info

KADR_MYSQL_ROOT_PASSWORD=kadr-root-dev
KADR_MYSQL_DATABASE=kadr
KADR_MYSQL_USER=kadr
KADR_MYSQL_PASSWORD=kadr-dev
KADR_MYSQL_DSN=kadr:kadr-dev@tcp(mysql:3306)/kadr?parseTime=true&charset=utf8mb4&loc=UTC&timeout=5s&multiStatements=true

# Worker: single-threaded queue on 2 GB VPS
KADR_WORKER_CONCURRENCY=1
KADR_WORKER_POLL_INTERVAL=5s

# Dev SMTP catcher (Mailpit profile `dev`)
KADR_SMTP_HOST=mailpit
KADR_SMTP_PORT=1025
