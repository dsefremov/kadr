# Optional local overrides (copy to deploy/dev.local.env, gitignored).
# Used only with COMPOSE_PROFILES=dev — CI does not load this file.
#
# When worker cannot reach hostname mailpit:1025 from inside Docker, scripts
# compose-dev-bridge-env.sh / ci-integration.sh set these automatically:
# KADR_SMTP_HOST=<bridge-gateway>
# KADR_SMTP_PORT=1025
#
# KADR_MYSQL_DSN=kadr:kadr-dev@tcp(172.18.0.1:3306)/kadr?parseTime=true&charset=utf8mb4&loc=UTC&timeout=5s&multiStatements=true
